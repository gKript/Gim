CREATE DB test_records_csv;
SET DB VOLATILE;
CREATE TABLE trn;
PIN TABLE trn;
ADD FIELD 1 INT label;
ADD FIELD 2 INT ch0;
ADD FIELD 3 INT ch0_ok;
ADD FIELD 4 INT ch1;
ADD FIELD 5 INT ch1_ok;
UNPIN TABLE;
CREATE TABLE trn2;
PIN TABLE trn2;
ADD FIELD 1 INT label;
ADD FIELD 2 INT ch0;
ADD FIELD 3 INT ch0_ok;
ADD FIELD 4 INT ch1;
ADD FIELD 5 INT ch1_ok;
UNPIN TABLE;
CREATE TABLE nts;
PIN TABLE nts;
ADD FIELD 1 INT id;
SET FIELD 1 KEY;
ADD FIELD 2 STRING nota;
ADD FIELD 3 FLOAT temp;
ADD FIELD 4 BOOL ok;
UNPIN TABLE;
CREATE TABLE nts2;
PIN TABLE nts2;
ADD FIELD 1 INT id;
SET FIELD 1 KEY;
ADD FIELD 2 STRING nota;
ADD FIELD 3 FLOAT temp;
ADD FIELD 4 BOOL ok;
UNPIN TABLE;
